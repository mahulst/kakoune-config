# Alabaster Dark-inspired theme for Kakoune
# Principles from tonsky.me/blog/syntax-highlighting/

# Palette
declare-option str alabaster_bg            "rgb:24273a"
declare-option str alabaster_fg            "rgb:cecece"
declare-option str alabaster_blue          "rgb:71ade7"
declare-option str alabaster_green         "rgb:95cb82"
declare-option str alabaster_purple        "rgb:cc8bc9"
declare-option str alabaster_comment       "rgb:ffe36e"
declare-option str alabaster_gray          "rgb:708b8d"
declare-option str alabaster_light_gray    "rgb:363a4f"
declare-option str alabaster_selection_text "rgb:c4c4c4"
declare-option str alabaster_selection     "rgb:5b6078"
declare-option str alabaster_selection_alt "rgb:6e738d"
declare-option str alabaster_line          "rgb:1e2030"
declare-option str alabaster_error         "rgb:cc3333"

# Markup
set-face global title  "%opt{alabaster_blue}"
set-face global header "%opt{alabaster_blue}"
set-face global bold   "%opt{alabaster_fg}"
set-face global italic "%opt{alabaster_fg}"
set-face global mono   "%opt{alabaster_green}"
set-face global block  "%opt{alabaster_gray}"
set-face global link   "%opt{alabaster_blue}"
set-face global bullet "%opt{alabaster_gray}"
set-face global list   "%opt{alabaster_fg}"

# Builtins
set-face global Default            "%opt{alabaster_fg},%opt{alabaster_bg}"
set-face global PrimarySelection   "%opt{alabaster_selection_text},%opt{alabaster_selection}"
set-face global SecondarySelection "%opt{alabaster_selection_text},%opt{alabaster_selection_alt}"
set-face global PrimaryCursor      "%opt{alabaster_bg},%opt{alabaster_blue}"
set-face global SecondaryCursor    "%opt{alabaster_bg},%opt{alabaster_gray}"
set-face global PrimaryCursorEol   "%opt{alabaster_bg},%opt{alabaster_blue}"
set-face global SecondaryCursorEol "%opt{alabaster_bg},%opt{alabaster_gray}"
set-face global LineNumbers        "%opt{alabaster_gray},%opt{alabaster_bg}"
set-face global LineNumberCursor   "%opt{alabaster_blue},%opt{alabaster_bg}"
set-face global LineNumbersWrapped "%opt{alabaster_gray},%opt{alabaster_bg}"
set-face global MenuForeground     "%opt{alabaster_fg},%opt{alabaster_light_gray}"
set-face global MenuBackground     "%opt{alabaster_fg},%opt{alabaster_line}"
set-face global MenuInfo           "%opt{alabaster_bg},%opt{alabaster_blue}"
set-face global Information        "%opt{alabaster_fg},%opt{alabaster_line}"
set-face global Error              "%opt{alabaster_error},%opt{alabaster_bg}"
set-face global StatusLine         "%opt{alabaster_fg},%opt{alabaster_line}"
set-face global StatusLineMode     "%opt{alabaster_fg},%opt{alabaster_light_gray}"
set-face global StatusLineInfo     "%opt{alabaster_bg},%opt{alabaster_blue}"
set-face global StatusLineValue    "%opt{alabaster_fg},%opt{alabaster_line}"
set-face global StatusCursor       "%opt{alabaster_bg},%opt{alabaster_blue}"
set-face global Prompt             "%opt{alabaster_blue},%opt{alabaster_bg}"
set-face global MatchingChar       "%opt{alabaster_blue},%opt{alabaster_bg}+u"
set-face global Whitespace         "%opt{alabaster_gray},%opt{alabaster_bg}"
set-face global WrapMarker         Whitespace
set-face global BufferPadding      "%opt{alabaster_bg},%opt{alabaster_bg}"

# Code (minimal classes)
set-face global value          "%opt{alabaster_purple}"
set-face global type           "%opt{alabaster_fg}"
set-face global variable       "%opt{alabaster_blue}"
set-face global module         "%opt{alabaster_blue}"
set-face global function       "%opt{alabaster_blue}"
set-face global string         "%opt{alabaster_green}"
set-face global keyword        "%opt{alabaster_fg}"
set-face global operator       "%opt{alabaster_gray}"
set-face global attribute      "%opt{alabaster_fg}"
set-face global comment        "%opt{alabaster_comment}"
set-face global documentation  comment
set-face global meta           "%opt{alabaster_fg}"
set-face global builtin        "%opt{alabaster_fg}"

# Tree-sitter
set-face global ts_attribute                    "%opt{alabaster_fg}"
set-face global ts_comment                      "%opt{alabaster_comment}"
set-face global ts_conceal                      "%opt{alabaster_gray}"
set-face global ts_constant                     "%opt{alabaster_purple}"
set-face global ts_constant_builtin_boolean     "%opt{alabaster_purple}"
set-face global ts_constant_character           "%opt{alabaster_purple}"
set-face global ts_constant_macro               "%opt{alabaster_purple}"
set-face global ts_constructor                  "%opt{alabaster_blue}"
set-face global ts_diff_plus                    "%opt{alabaster_green}"
set-face global ts_diff_minus                   "%opt{alabaster_error}"
set-face global ts_diff_delta                   "%opt{alabaster_blue}"
set-face global ts_diff_delta_moved             "%opt{alabaster_purple}"
set-face global ts_error                        "%opt{alabaster_error}"
set-face global ts_function                     "%opt{alabaster_blue}"
set-face global ts_function_call                "%opt{alabaster_fg}"
set-face global ts_function_method              "%opt{alabaster_blue}"
set-face global ts_function_method_call         "%opt{alabaster_fg}"
set-face global ts_function_definition          "%opt{alabaster_blue}"
set-face global ts_function_declaration         "%opt{alabaster_blue}"
set-face global ts_function_builtin             "%opt{alabaster_fg}"
set-face global ts_function_macro               "%opt{alabaster_blue}"
set-face global ts_hint                         "%opt{alabaster_blue}"
set-face global ts_info                         "%opt{alabaster_blue}"
set-face global ts_keyword                      "%opt{alabaster_fg}"
set-face global ts_keyword_conditional          "%opt{alabaster_fg}"
set-face global ts_keyword_control_conditional  "%opt{alabaster_fg}"
set-face global ts_keyword_control_directive    "%opt{alabaster_fg}"
set-face global ts_keyword_control_import       "%opt{alabaster_fg}"
set-face global ts_keyword_directive            "%opt{alabaster_fg}"
set-face global ts_keyword_storage              "%opt{alabaster_fg}"
set-face global ts_keyword_storage_modifier     "%opt{alabaster_fg}"
set-face global ts_keyword_storage_modifier_mut "%opt{alabaster_fg}"
set-face global ts_keyword_storage_modifier_ref "%opt{alabaster_fg}"
set-face global ts_label                        "%opt{alabaster_blue}"
set-face global ts_markup_bold                  "%opt{alabaster_fg}"
set-face global ts_markup_heading               "%opt{alabaster_blue}"
set-face global ts_markup_heading_1             "%opt{alabaster_blue}"
set-face global ts_markup_heading_2             "%opt{alabaster_blue}"
set-face global ts_markup_heading_3             "%opt{alabaster_blue}"
set-face global ts_markup_heading_4             "%opt{alabaster_blue}"
set-face global ts_markup_heading_5             "%opt{alabaster_blue}"
set-face global ts_markup_heading_6             "%opt{alabaster_blue}"
set-face global ts_markup_heading_marker        "%opt{alabaster_gray}"
set-face global ts_markup_italic                "%opt{alabaster_fg}"
set-face global ts_markup_list_checked          "%opt{alabaster_gray}"
set-face global ts_markup_list_numbered         "%opt{alabaster_gray}"
set-face global ts_markup_list_unchecked        "%opt{alabaster_gray}"
set-face global ts_markup_list_unnumbered       "%opt{alabaster_gray}"
set-face global ts_markup_link_label            "%opt{alabaster_blue}"
set-face global ts_markup_link_url              "%opt{alabaster_blue}+u"
set-face global ts_markup_link_uri              "%opt{alabaster_blue}+u"
set-face global ts_markup_link_text             "%opt{alabaster_blue}"
set-face global ts_markup_quote                 "%opt{alabaster_comment}"
set-face global ts_markup_raw                   "%opt{alabaster_green}"
set-face global ts_markup_strikethrough         "%opt{alabaster_gray}+s"
set-face global ts_namespace                    "%opt{alabaster_blue}"
set-face global ts_operator                     "%opt{alabaster_gray}"
set-face global ts_property                     "%opt{alabaster_fg}"
set-face global ts_punctuation                  "%opt{alabaster_gray}"
set-face global ts_punctuation_special          "%opt{alabaster_gray}"
set-face global ts_special                      "%opt{alabaster_fg}"
set-face global ts_spell                        "%opt{alabaster_gray}"
set-face global ts_string                       "%opt{alabaster_green}"
set-face global ts_string_regex                 "%opt{alabaster_green}"
set-face global ts_string_regexp                "%opt{alabaster_green}"
set-face global ts_string_escape                "%opt{alabaster_gray}"
set-face global ts_string_special               "%opt{alabaster_green}"
set-face global ts_string_special_path          "%opt{alabaster_green}"
set-face global ts_string_special_symbol        "%opt{alabaster_green}"
set-face global ts_string_symbol                "%opt{alabaster_green}"
set-face global ts_tag                          "%opt{alabaster_blue}"
set-face global ts_tag_error                    "%opt{alabaster_error}"
set-face global ts_text                         "%opt{alabaster_fg}"
set-face global ts_text_title                   "%opt{alabaster_blue}"
set-face global ts_type                         "%opt{alabaster_fg}"
set-face global ts_type_builtin                 "%opt{alabaster_fg}"
set-face global ts_type_definition              "%opt{alabaster_blue}"
set-face global ts_type_declaration             "%opt{alabaster_blue}"
set-face global ts_type_alias                   "%opt{alabaster_blue}"
set-face global ts_type_enum_variant            "%opt{alabaster_blue}"
set-face global ts_variable                     "%opt{alabaster_blue}"
set-face global ts_variable_definition          "%opt{alabaster_blue}"
set-face global ts_variable_declaration         "%opt{alabaster_blue}"
set-face global ts_variable_builtin             "%opt{alabaster_fg}"
set-face global ts_variable_other_member        "%opt{alabaster_fg}"
set-face global ts_variable_parameter           "%opt{alabaster_blue}"
set-face global ts_warning                      "%opt{alabaster_error}"

# Declaration-name highlights for non-tree-sitter JS/TS
define-command -hidden -override alabaster-apply-decl-names %{
    try %{ remove-highlighter window/alabaster_decl_names }
    add-highlighter window/alabaster_decl_names regex '\b(const|let|var)[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 2:variable
    add-highlighter window/alabaster_decl_names regex '\bexport[ \t]+(const|let|var)[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 2:variable
    add-highlighter window/alabaster_decl_names regex '\bfunction[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 1:function
    add-highlighter window/alabaster_decl_names regex '\bexport[ \t]+function[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 1:function
    add-highlighter window/alabaster_decl_names regex '\btype[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 1:variable
    add-highlighter window/alabaster_decl_names regex '\bexport[ \t]+type[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 1:variable
    add-highlighter window/alabaster_decl_names regex '\b(interface|class|enum)[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 2:variable
    add-highlighter window/alabaster_decl_names regex '\bexport[ \t]+(interface|class|enum)[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 2:variable
    add-highlighter window/alabaster_decl_names regex '\b(abstract)[ \t]+(class)[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 3:variable
    add-highlighter window/alabaster_decl_names regex '\bexport[ \t]+(abstract)[ \t]+(class)[ \t]+([A-Za-z_$][A-Za-z0-9_$]*)' 3:variable
}

remove-hooks global alabaster-decl
hook -group alabaster-decl global WinSetOption filetype=.* %{ try %{ remove-highlighter window/alabaster_decl_names } }
hook -group alabaster-decl global WinSetOption filetype=(typescript|tsx|javascript|jsx) %{ alabaster-apply-decl-names }
